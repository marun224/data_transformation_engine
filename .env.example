# Copy to `.env` and fill in. `.env` is gitignored; this file must never hold real secrets.
#
# Precedence (highest wins):
#   Session.builder.config(...)  >  process env  >  .env  >  built-in defaults
#
# Every key below also has a conf-key equivalent accepted by `.config(...)`, e.g.
#   ICETL_CATALOG_URI  ==  icetl.catalog.<name>.uri

# --- Catalog -----------------------------------------------------------------
# Name the catalog answers to in table refs like `mycat.nyc.yellow_tripdata`.
# Table refs that omit it (`nyc.yellow_tripdata`) resolve to this catalog.
ICETL_CATALOG_NAME=rest
ICETL_CATALOG_TYPE=rest
ICETL_CATALOG_URI=http://localhost:8182
# Warehouse root, as the catalog reports it. Optional for most REST catalogs.
#ICETL_CATALOG_WAREHOUSE=s3://warehouse

# Default namespace for unqualified table names (`session.table("yellow_tripdata")`).
ICETL_DEFAULT_NAMESPACE=nyc

# --- Object store (MinIO) ----------------------------------------------------
# Falls back to the standard AWS_* names when these are unset.
ICETL_S3_ENDPOINT=http://localhost:9000
ICETL_S3_ACCESS_KEY_ID=<access-key>
ICETL_S3_SECRET_ACCESS_KEY=<secret-key>
ICETL_S3_REGION=us-east-1
# MinIO needs path-style addressing; real AWS S3 does not.
ICETL_S3_PATH_STYLE_ACCESS=true

# --- DuckDB engine -----------------------------------------------------------
# All optional. Unset means "use every core, size memory from available RAM" (P7).
#ICETL_DUCKDB_THREADS=8
#ICETL_DUCKDB_MEMORY_LIMIT=24GB
#ICETL_DUCKDB_TEMP_DIRECTORY=.scratch/duckdb-spill

# --- Integration suite -------------------------------------------------------
# Only read by `pytest -m integration`. The suite creates and drops tables in
# ICETL_IT_NAMESPACE and refuses to run if that names a protected namespace.
#ICETL_IT_NAMESPACE=icetl_it
# Namespaces the suite must never write to, and whose snapshots it verifies are
# unchanged before and after every run.
#ICETL_IT_PROTECTED=nyc,amazon
# The window of real data the seed tables are carved from (half-open).
#ICETL_IT_SEED_START=2024-06-01
#ICETL_IT_SEED_END=2024-06-08
# Which real tables the suite reads. Every one has a working default.
#ICETL_TEST_NAMESPACE=nyc
#ICETL_TEST_TABLE=yellow_tripdata
#ICETL_TEST_WIDE_TABLE=wide_smoke
#ICETL_TEST_HUGE_TABLE=yellow_tripdata_wide
#ICETL_TEST_TIME_COLUMN=tpep_pickup_datetime
